---
import BaseLayout from '../layouts/BaseLayout.astro';
import { terms } from '../data/glossary.js';
---

<BaseLayout
  title="Glossary | CS Moodle"
  pageId="glossary"
  activeNav="glossary"
  description="Search computer science terms and definitions."
>
  <div class="section-wrap">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-9">
          <div class="section-header">
            <h2>CS Glossary</h2>
            <p>Quickly search key computer science terms and definitions.</p>
          </div>
          <div class="search-panel glossary-search-panel mb-4" role="search">
            <label class="visually-hidden" for="glossary-search">Search glossary</label>
            <i class="bi bi-search glossary-search-icon" aria-hidden="true"></i>
            <input id="glossary-search" type="search" class="form-control" placeholder="Search a term or definition…" autocomplete="off" aria-describedby="glossary-search-help" />
            <button type="button" class="glossary-clear-search" id="glossary-clear-search" aria-label="Clear search" hidden>
              <i class="bi bi-x-circle-fill" aria-hidden="true"></i>
            </button>
            <div class="form-text" id="glossary-search-help">Search matches both terms and definitions as you type.</div>
          </div>
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3 glossary-toolbar">
            <div id="glossary-count" class="text-muted" role="status" aria-live="polite">5 total terms</div>
            <button class="btn btn-sm btn-outline-secondary" id="glossary-show-all" type="button">Show all terms</button>
          </div>
          <div id="glossary-results">
            {terms.map((item) => (
              <article class="glossary-row" data-term={item.term} data-def={item.definition}>
                <h3 class="glossary-term">{item.term}</h3>
                <p class="glossary-definition">{item.definition}</p>
              </article>
            ))}
          </div>
          <section id="glossary-external-section" class="glossary-external-section" aria-labelledby="glossary-external-heading" hidden>
            <div class="glossary-external-heading">
              <div>
                <h3 id="glossary-external-heading">Related computer science articles</h3>
                <p>Supplementary results from Wikipedia. Your curated glossary remains the primary source.</p>
              </div>
              <span class="glossary-source-badge"><i class="bi bi-globe2" aria-hidden="true"></i> Wikipedia</span>
            </div>
            <div id="glossary-external-status" class="glossary-external-status" role="status" aria-live="polite"></div>
            <div id="glossary-external-results"></div>
            <p class="glossary-attribution">Wikipedia text is by its contributors and available under the <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">Creative Commons Attribution-ShareAlike 4.0 License</a>.</p>
          </section>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const searchInput = document.getElementById("glossary-search");
      const clearBtn = document.getElementById("glossary-clear-search");
      const countEl = document.getElementById("glossary-count");
      const showAllBtn = document.getElementById("glossary-show-all");
      const resultsContainer = document.getElementById("glossary-results");
      const externalSection = document.getElementById("glossary-external-section");
      const externalStatus = document.getElementById("glossary-external-status");
      const externalResults = document.getElementById("glossary-external-results");

      const rows = Array.from(document.querySelectorAll(".glossary-row")).map((el) => ({
        el,
        term: el.dataset.term,
        def: el.dataset.def,
      }));

      let searchTimer = null;
      let searchController = null;
      let requestId = 0;

      function escapeHtml(str) {
        return String(str ?? "").replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      }

      function highlight(text, query) {
        if (!query) return escapeHtml(text);
        const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        const matcher = new RegExp(`(${escaped})`, "gi");
        return text.split(matcher).map((part) =>
          part.toLowerCase() === query.toLowerCase() ? `<mark>${escapeHtml(part)}</mark>` : escapeHtml(part)
        ).join("");
      }

      function renderResults(rawQuery) {
        const query = String(rawQuery || "").trim().toLowerCase();
        let matches = 0;

        rows.forEach(({ el, term, def }) => {
          const matched = !query || term.toLowerCase().includes(query) || def.toLowerCase().includes(query);
          el.style.display = matched ? "" : "none";
          if (matched) {
            matches++;
            el.querySelector(".glossary-term").innerHTML = highlight(term, query);
            el.querySelector(".glossary-definition").innerHTML = highlight(def, query);
          }
        });

        if (clearBtn) clearBtn.hidden = !query;

        if (countEl) {
          if (!query) {
            countEl.textContent = `${matches} total term${matches === 1 ? "" : "s"}`;
          } else {
            countEl.textContent = `${matches} term${matches === 1 ? "" : "s"} matching "${rawQuery}"`;
          }
        }
      }

      function searchWikipedia(rawQuery) {
        const query = String(rawQuery || "").trim();
        const currentReq = ++requestId;

        if (searchController) {
          searchController.abort();
          searchController = null;
        }
        clearTimeout(searchTimer);

        if (query.length < 3) {
          if (externalSection) externalSection.hidden = true;
          return;
        }

        if (externalSection) externalSection.hidden = false;
        if (externalStatus) externalStatus.textContent = "Searching Wikipedia…";
        if (externalResults) externalResults.replaceChildren();

        searchTimer = setTimeout(() => {
          searchController = new AbortController();
          const params = new URLSearchParams({
            action: "query",
            generator: "search",
            gsrsearch: query,
            gsrlimit: "5",
            prop: "extracts|info",
            exintro: "1",
            explaintext: "1",
            exchars: "700",
            inprop: "url",
            format: "json",
            origin: "*",
          });

          fetch(`https://en.wikipedia.org/w/api.php?${params}`, { signal: searchController.signal })
            .then((res) => {
              if (!res.ok) throw new Error(`HTTP ${res.status}`);
              return res.json();
            })
            .then((data) => {
              if (currentReq !== requestId) return;
              if (data.error) throw new Error(data.error.info || "Wikipedia error");

              const queryPages = data.query && data.query.pages ? data.query.pages : {};
              const pages = Object.values(queryPages).sort((a, b) => (a.index || 0) - (b.index || 0));
              const valid = pages.filter((p) => p.title && p.extract && p.fullurl);

              if (!valid.length) {
                if (externalStatus) externalStatus.textContent = "No related Wikipedia articles found for this search.";
                return;
              }

              if (externalResults) {
                externalResults.replaceChildren();
                valid.forEach((p) => {
                  const article = document.createElement("article");
                  article.className = "glossary-external-result";
                  const h4 = document.createElement("h4");
                  const link = document.createElement("a");
                  link.href = p.fullurl;
                  link.target = "_blank";
                  link.rel = "noopener noreferrer";
                  link.textContent = p.title;
                  h4.appendChild(link);
                  const pEl = document.createElement("p");
                  pEl.textContent = p.extract.trim();
                  article.append(h4, pEl);
                  externalResults.appendChild(article);
                });
              }
              if (externalStatus) externalStatus.textContent = `${valid.length} related article${valid.length === 1 ? "" : "s"} found.`;
            })
            .catch((err) => {
              if (err.name === "AbortError" || currentReq !== requestId) return;
              console.warn("Wikipedia search unavailable:", err);
              if (externalStatus) externalStatus.textContent = "Wikipedia search is unavailable right now. Your curated glossary is still available.";
            });
        }, 400);
      }

      if (searchInput) {
        searchInput.addEventListener("input", () => {
          renderResults(searchInput.value);
          searchWikipedia(searchInput.value);
        });
      }

      if (clearBtn) {
        clearBtn.addEventListener("click", () => {
          if (searchInput) {
            searchInput.value = "";
            renderResults("");
            searchWikipedia("");
            searchInput.focus();
          }
        });
      }

      if (showAllBtn) {
        showAllBtn.addEventListener("click", () => {
          if (searchInput) {
            searchInput.value = "";
            renderResults("");
            searchWikipedia("");
          }
        });
      }
    })();
  </script>
</BaseLayout>
