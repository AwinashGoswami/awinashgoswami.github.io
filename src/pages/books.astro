---
import BaseLayout from '../layouts/BaseLayout.astro';

import { categories, books } from '../data/books.js';
---

<BaseLayout
  title="Books | CS Moodle"
  pageId="books"
  activeNav="books"
  description="Browse free and openly available computer science books."
>
  <div class="section-wrap books-page">
    <div class="container">
      <div class="section-header">
        <span class="books-eyebrow"><i class="bi bi-book-half" aria-hidden="true"></i> Open learning library</span>
        <h2>Computer Science Books</h2>
        <p>Browse computer science books with free PDF access from their authors or publishers.</p>
      </div>
      <div class="search-panel glossary-search-panel book-search-panel mb-3" role="search">
        <label class="visually-hidden" for="books-search">Search books</label>
        <i class="bi bi-search glossary-search-icon" aria-hidden="true"></i>
        <input id="books-search" type="search" class="form-control" placeholder="Search by title, author, category, or description…" autocomplete="off" aria-describedby="books-search-help" />
        <button type="button" class="glossary-clear-search" id="books-clear-search" aria-label="Clear search" hidden>
          <i class="bi bi-x-circle-fill" aria-hidden="true"></i>
        </button>
        <div class="form-text" id="books-search-help">Search matches titles, authors, categories, and descriptions as you type.</div>
      </div>

      <div class="book-filters" role="group" aria-label="Filter books by category">
        {categories.map((item) => (
          <button
            class={`book-filter ${item === 'All' ? 'active' : ''}`}
            type="button"
            data-book-category={item}
            aria-pressed={item === 'All'}
          >{item}</button>
        ))}
      </div>
      <div class="books-results-count" id="books-results-count" role="status" aria-live="polite">
        Showing {books.length} books
      </div>
      <div class="books-grid" id="books-grid">
        {books.map((book) => (
          <article
            class="book-card"
            data-categories={book.categories.join(',')}
            data-title={book.title}
            data-author={book.author}
            data-description={book.description}
            data-url={book.actionUrl}
            data-href={book.actionUrl}
            data-action-url={book.actionUrl}
            tabindex="0"
            role="link"
            aria-label={`Open ${book.title} PDF`}
          >
            <span class="book-external-link" aria-hidden="true"><i class="bi bi-box-arrow-up-right"></i></span>
            <div class={`book-cover book-cover--${book.coverTheme}`} role="img" aria-label={`Illustrated cover for ${book.title}`}>
              <span class="book-cover-mark" aria-hidden="true"><i class="bi bi-book-half"></i></span>
              <span class="book-cover-label">{book.coverLabel}</span>
              <span class="book-cover-title">{book.title}</span>
              <span class="book-cover-author">{book.author}</span>
            </div>
            <div class="book-card-body">
              <div class="book-category-tags">
                {book.categories.map((cat) => (
                  <span class="book-category-tag">{cat}</span>
                ))}
              </div>
              <h3>{book.title}</h3>
              <p class="book-author">{book.author}</p>
              <p class="book-description">{book.description}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="books-load-more-wrap" id="books-load-more-wrap">
        <button type="button" class="btn btn-outline-primary books-load-more" id="books-load-more" hidden>Load more books</button>
      </div>
      <div class="books-empty-state" id="books-empty-state" hidden>
        <i class="bi bi-search" aria-hidden="true"></i>
        <p>No books match your search.</p>
      </div>
      <p class="books-license-note"><i class="bi bi-info-circle" aria-hidden="true"></i> Books remain the property of their authors. Availability and license terms vary; check each official source before reusing or redistributing a book.</p>
    </div>
  </div>

  <script is:inline>
    (function () {
      const PAGE_SIZE = 20;
      const searchInput = document.getElementById('books-search');
      const clearBtn = document.getElementById('books-clear-search');
      const countEl = document.getElementById('books-results-count');
      const loadMoreBtn = document.getElementById('books-load-more');
      const loadMoreWrap = document.getElementById('books-load-more-wrap');
      const emptyState = document.getElementById('books-empty-state');
      const buttons = document.querySelectorAll('[data-book-category]');
      const cards = Array.prototype.slice.call(document.querySelectorAll('.book-card'));

      let currentCategory = 'All';
      let currentQuery = '';
      let shown = PAGE_SIZE;

      function cardText(card) {
        return [
          card.dataset.title || '',
          card.dataset.author || '',
          card.dataset.description || '',
          card.dataset.categories || ''
        ].join(' ').toLowerCase();
      }

      function filteredCards() {
        return cards.filter(function (card) {
          const cats = card.dataset.categories ? card.dataset.categories.split(',') : [];
          const catMatch = currentCategory === 'All' || cats.indexOf(currentCategory) !== -1;
          if (!catMatch) return false;
          if (!currentQuery) return true;
          return cardText(card).indexOf(currentQuery) !== -1;
        });
      }

      function render() {
        const filtered = filteredCards();
        cards.forEach(function (card) { card.style.display = 'none'; });
        const limit = Math.min(shown, filtered.length);
        for (let i = 0; i < limit; i++) {
          filtered[i].style.display = '';
        }
        if (emptyState) {
          emptyState.hidden = filtered.length !== 0;
        }
        if (countEl) {
          const noun = filtered.length === 1 ? 'book' : 'books';
          if (filtered.length > shown) {
            countEl.textContent = 'Showing ' + limit + ' of ' + filtered.length + ' ' + noun;
          } else if (currentCategory === 'All' && !currentQuery) {
            countEl.textContent = 'Showing ' + filtered.length + ' ' + noun;
          } else {
            countEl.textContent = 'Showing ' + filtered.length + ' ' + noun + (currentCategory !== 'All' ? ' in ' + currentCategory : '');
          }
        }
        if (loadMoreBtn) {
          const hasMore = filtered.length > limit;
          loadMoreBtn.hidden = !hasMore;
          if (loadMoreWrap) loadMoreWrap.style.display = hasMore ? '' : 'none';
        }
      }

      function resetAndRender() {
        shown = PAGE_SIZE;
        render();
      }

      function filterCategory(category) {
        currentCategory = category || 'All';
        buttons.forEach(function (btn) {
          const match = btn.dataset.bookCategory === currentCategory;
          btn.classList.toggle('active', match);
          btn.setAttribute('aria-pressed', String(match));
        });
        resetAndRender();
      }

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          filterCategory(btn.dataset.bookCategory);
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', function () {
          currentQuery = searchInput.value.trim().toLowerCase();
          if (clearBtn) clearBtn.hidden = !currentQuery;
          resetAndRender();
        });
      }
      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          if (searchInput) {
            searchInput.value = '';
            currentQuery = '';
            clearBtn.hidden = true;
            searchInput.focus();
            resetAndRender();
          }
        });
      }
      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function () {
          shown += PAGE_SIZE;
          render();
        });
      }

      cards.forEach(function (card) {
        const url = card.dataset.url || card.dataset.href || card.dataset.actionUrl;
        function open() {
          if (url) window.open(url, '_blank', 'noopener,noreferrer');
        }
        card.addEventListener('click', open);
        card.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            open();
          }
        });
      });

      const params = new URLSearchParams(window.location.search);
      const cat = params.get('category');
      if (cat) filterCategory(cat);
      else render();
    })();
  </script>
</BaseLayout>
